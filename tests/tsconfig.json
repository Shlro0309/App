{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": "..",
    "typeRoots": ["../src/frontend/node_modules/@types"],
    "paths": {
      "@playwright/test": ["./src/frontend/node_modules/@playwright/test"],
      "@playwright/test/*": ["./src/frontend/node_modules/@playwright/test/*"]
    }
  },
  "include": ["e2e/**/*.ts"]
}
